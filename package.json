{
  "name": "dateplate",
  "version": "0.0.1",
  "private": true,
  "description": "커플 미식 아카이빙 플랫폼",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:api": "pnpm --filter @dateplate/api dev",
    "dev:web": "pnpm --filter @dateplate/web dev",
    "build": "pnpm -r run build",
    "build:api": "pnpm --filter @dateplate/api build",
    "build:web": "pnpm --filter @dateplate/web build",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "pnpm -r run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
