generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ==================== User & Auth ====================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  companyAddress   String?
  companyLatitude  Float?
  companyLongitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamMembers   TeamMember[]
  sentInvites   TeamInvite[]   @relation("InviteSender")
  reviews       Review[]
  dinnerRecords DinnerRecord[]
  sessions      Session[]      @relation("SessionCreator")
}

// ==================== Team ====================

model Team {
  id         String   @id @default(cuid())
  name       String
  profileUrl String?
  leaderId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members      TeamMember[]
  invites      TeamInvite[]
  dinnerRecords DinnerRecord[]
  reviews      Review[]
  sessions     Session[]
}

model TeamMember {
  id     String @id @default(cuid())
  role   String @default("MEMBER") // LEADER | MEMBER
  userId String
  teamId String

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

model TeamInvite {
  id         String   @id @default(cuid())
  inviteCode String   @unique
  status     String   @default("PENDING") // PENDING | ACCEPTED | EXPIRED | CANCELLED
  inviteeId  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  teamId    String
  inviterId String
  team      Team @relation(fields: [teamId], references: [id])
  inviter   User @relation("InviteSender", fields: [inviterId], references: [id])
}

// ==================== Restaurant ====================

model Restaurant {
  id           String   @id @default(cuid())
  name         String
  address      String?
  latitude     Float?
  longitude    Float?
  category     String?
  kakaoPlaceId String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dinnerRecords DinnerRecord[]
  reviews       Review[]
  sessionOptions SessionOption[]
}

// ==================== Dinner Record ====================

model DinnerRecord {
  id          String   @id @default(cuid())
  date        DateTime
  memo        String?
  totalAmount Int?
  headcount   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teamId       String
  restaurantId String
  createdBy    String
  team         Team       @relation(fields: [teamId], references: [id])
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  creator      User       @relation(fields: [createdBy], references: [id])
  reviews      Review[]
}

// ==================== Review ====================

model Review {
  id         String   @id @default(cuid())
  content    String?
  rating     Int
  isVerified Boolean  @default(false)
  visibility String   @default("PRIVATE") // PRIVATE | COMMUNITY | PUBLIC
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  teamId       String
  restaurantId String
  dinnerRecordId String
  authorId     String
  team         Team         @relation(fields: [teamId], references: [id])
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  dinnerRecord DinnerRecord @relation(fields: [dinnerRecordId], references: [id])
  author       User         @relation(fields: [authorId], references: [id])
  images       ReviewImage[]
  tags         ReviewTag[]

  @@unique([dinnerRecordId, authorId])
}

model ReviewImage {
  id        String   @id @default(cuid())
  imageUrl  String
  type      String // RECEIPT | PHOTO
  createdAt DateTime @default(now())

  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model ReviewTag {
  id   String @id @default(cuid())
  name String @unique

  reviews Review[]
}

// ==================== Session (Tournament / Roulette) ====================

model Session {
  id        String   @id @default(cuid())
  type      String   // TOURNAMENT | ROULETTE
  status    String   @default("ACTIVE") // ACTIVE | COMPLETED
  title     String?
  result    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamId    String
  creatorId String
  team      Team    @relation(fields: [teamId], references: [id])
  creator   User    @relation("SessionCreator", fields: [creatorId], references: [id])

  options SessionOption[]
  votes   SessionVote[]
}

model SessionOption {
  id           String  @id @default(cuid())
  name         String
  weight       Int     @default(1)

  sessionId    String
  restaurantId String?
  session      Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])

  votes SessionVote[]
}

model SessionVote {
  id        String   @id @default(cuid())
  round     Int      @default(1)
  createdAt DateTime @default(now())

  sessionId String
  optionId  String
  voterId   String
  session   Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  option    SessionOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
}

// ==================== Gamification ====================

model Ticket {
  id        String   @id @default(cuid())
  type      String   // GOLDEN | BLACK
  month     Int
  year      Int
  createdAt DateTime @default(now())

  teamId    String
  fromUserId String
  toUserId   String

  @@unique([teamId, fromUserId, toUserId, month, year])
}

model Achievement {
  id          String   @id @default(cuid())
  code        String   // e.g., FIRST_REVIEW, DINNER_10, STREAK_3
  unlockedAt  DateTime @default(now())

  userId String

  @@unique([userId, code])
}

model Mission {
  id          String @id @default(cuid())
  code        String @unique
  title       String
  description String
  targetCount Int
  reward      String // e.g., BADGE, POINT
  isActive    Boolean @default(true)
}

model MissionProgress {
  id           String @id @default(cuid())
  currentCount Int    @default(0)
  completed    Boolean @default(false)
  completedAt  DateTime?

  userId    String
  missionId String

  @@unique([userId, missionId])
}
