generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
}

// ==================== User & Auth ====================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamMembers   TeamMember[]
  sentInvites   TeamInvite[]   @relation("InviteSender")
  reviews       Review[]
  dinnerRecords DinnerRecord[]
}

// ==================== Team ====================

model Team {
  id         String   @id @default(cuid())
  name       String
  profileUrl String?
  leaderId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members      TeamMember[]
  invites      TeamInvite[]
  dinnerRecords DinnerRecord[]
  reviews      Review[]
}

model TeamMember {
  id     String @id @default(cuid())
  role   String @default("MEMBER") // LEADER | MEMBER
  userId String
  teamId String

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

model TeamInvite {
  id         String   @id @default(cuid())
  inviteCode String   @unique
  status     String   @default("PENDING") // PENDING | ACCEPTED | EXPIRED | CANCELLED
  inviteeId  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  teamId    String
  inviterId String
  team      Team @relation(fields: [teamId], references: [id])
  inviter   User @relation("InviteSender", fields: [inviterId], references: [id])
}

// ==================== Restaurant ====================

model Restaurant {
  id           String   @id @default(cuid())
  name         String
  address      String?
  latitude     Float?
  longitude    Float?
  category     String?
  kakaoPlaceId String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dinnerRecords DinnerRecord[]
  reviews       Review[]
}

// ==================== Dinner Record ====================

model DinnerRecord {
  id          String   @id @default(cuid())
  date        DateTime
  memo        String?
  totalAmount Int?
  headcount   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teamId       String
  restaurantId String
  createdBy    String
  team         Team       @relation(fields: [teamId], references: [id])
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  creator      User       @relation(fields: [createdBy], references: [id])
  review       Review?
}

// ==================== Review ====================

model Review {
  id         String   @id @default(cuid())
  content    String?
  rating     Int
  isVerified Boolean  @default(false)
  visibility String   @default("PRIVATE") // PRIVATE | COMMUNITY | PUBLIC
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  teamId       String
  restaurantId String
  dinnerRecordId String @unique
  authorId     String
  team         Team         @relation(fields: [teamId], references: [id])
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  dinnerRecord DinnerRecord @relation(fields: [dinnerRecordId], references: [id])
  author       User         @relation(fields: [authorId], references: [id])
  images       ReviewImage[]
  tags         ReviewTag[]
}

model ReviewImage {
  id        String   @id @default(cuid())
  imageUrl  String
  type      String // RECEIPT | PHOTO
  createdAt DateTime @default(now())

  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model ReviewTag {
  id   String @id @default(cuid())
  name String @unique

  reviews Review[]
}
